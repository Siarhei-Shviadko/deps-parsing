ENV=development

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_DB=parsing
DATABASE_USER=deps-postgres
DATABASE_PASSWORD=deps-postgres-password
MASTER_CHANGELOG=./migrations/master.yaml
DATABASE_DIALECT=postgresql
DATABASE_DRIVER=psycopg2
DATABASE_REQUIRE_SECURE_TRANSPORT=false

# asb kafka rabbitmq
MESSAGING_DRIVER=rabbitmq
MESSAGE_BROKER_CONNECTION_STRING=amqp://deps-rabbitmq:deps-rabbitmq-password@deps-rabbitmq:5672/deps

# kafka
KAFKA_GROUP_ID=parsing

# Auth
AUTH_VERIFY_SSL=false
AUTH_ENABLED=false
API_KEY=api-key

FILE_STORAGE_URL=http://deps-file-storage:8004
UNIFIER_URL=http://deps-unifier:8000
OCR_URL=http://ocr:8000
TABLES_URL=http://tables:8000
DOCUMENT_URL=http://deps-document-api:8000
FILE_URL=http://deps-file:8000
AI_FUSION_URL=http://deps-ai-fusion:8000
SEMANTIC_PARSING_URL=http://deps-semantic-parsing:8000

OBJECT_STORAGE_MODE=sync
OBJECT_STORAGE_TYPE=file-storage

AZURE_FORM_RECOGNIZER_API_URL=
AZURE_FORM_RECOGNIZER_API_KEY=
AZURE_CONNECTION_STRING=
AZURE_CONTAINER_NAME=

AWS_TEXTRACT_REGION_NAME="eu-central-1"
AWS_TEXTRACT_ACCESS_KEY_ID="ABCDEFG"
AWS_TEXTRACT_SECRET_ACCESS_KEY="ABCDEFG"
AWS_TEXTRACT_PARSING_STRATEGY=by_document
AWS_ACCESS_KEY_ID=ABCDEFG
AWS_SECRET_ACCESS_KEY=ABCDEFG
AWS_REGION=eu-central-1
AWS_EC2_METADATA_DISABLED=true
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET_NAME=parsing

GCP_BLOB_STORAGE_BUCKET_NAME=
GCP_BLOB_STORAGE_AUTH_KEY=

# by_page by_document
AZURE_PARSING_STRATEGY=by_document

# Telemetry
INSTRUMENTATION_ENABLED=false
EXPORTER_TYPE=azure
SERVICE_NAME=deps-parsing

# otlp example
OTLP_LOG_ENDPOINT=http://deps-otlp:4317
OTLP_TRACE_ENDPOINT=http://deps-otlp:4318/v1/traces
APPLICATION_INSIGHTS_CONNECTION_STRING=connection_string

MERGE_TABLES_ENABLED=true
IMG_ANNOTATION_LLM=aws-bedrock@anthropic.claude-images
IMG_ANNOTATION_WIDTH_PIXELS_THRESHOLD=150
IMG_ANNOTATION_HEIGHT_PIXELS_THRESHOLD=150
IMG_ANNOTATION_SIZE_BYTES_THRESHOLD=20000
